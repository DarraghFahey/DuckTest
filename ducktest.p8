pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
    playerx=63
    playery=63
    playerflip=false
    score=0
end

function _update()
    if(btn(0)) playerx-=1 playerflip=true
    if(btn(1)) playerx+=1 playerflip=false
    if(btn(2)) playery-=1 
    if(btn(3)) playery+=1
end

function _draw()
    cls() 
    map()
    spr(1, playerx, playery, 1,1, playerflip)
    spr(48, 7, 7)
end 
